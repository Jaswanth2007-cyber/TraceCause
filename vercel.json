{
  "version": 2,
  "functions": {
    "api/**/*.ts": {
      "includeFiles": "node_modules/sql.js/dist/**"
    },
    "api/*.ts": {
      "includeFiles": "node_modules/sql.js/dist/**"
    },
    "api/index.ts": {
      "includeFiles": "node_modules/sql.js/dist/**"
    },
    "server/src/index.ts": {
      "includeFiles": "node_modules/sql.js/dist/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    }
  ]
}
